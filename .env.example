# -----------------------------------------------------------------------------
# Pathao Courier Merchant API
# -----------------------------------------------------------------------------
# The values below are the SANDBOX credentials published in Pathao's merchant
# integration documentation. They are shared test credentials — safe to commit,
# useless against production.
#
# For production, swap in your own credentials from the Pathao merchant panel
# (Merchant API credentials section) and never commit them: .env is gitignored.

# Sandbox: https://courier-api-sandbox.pathao.com
# Live:    https://api-hermes.pathao.com
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com

PATHAO_CLIENT_ID=7N1aMJQbWm
PATHAO_CLIENT_SECRET=wRcaibZkUdSNz2EI9ZyuXLlNrnAv0TdPUPXMnD39
PATHAO_USERNAME=test@pathao.com
PATHAO_PASSWORD=lovePathao

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PORT=3000

# Where the OAuth token and the tracked orders live.
#
# Local development uses a SQLite file. Deployments set TURSO_DATABASE_URL
# instead, which points at a hosted libSQL database and takes precedence over
# DATABASE_FILE — that is what lets the app run somewhere with no disk.
DATABASE_FILE=./data/pathao.sqlite

# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Renew the access token this many seconds before it actually expires.
TOKEN_REFRESH_LEEWAY_SECONDS=300

# Timeout for outbound calls to Pathao, in milliseconds.
PATHAO_REQUEST_TIMEOUT_MS=20000
